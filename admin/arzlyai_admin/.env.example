# Copy to .env.[mode].local for machine-specific overrides (gitignored).
# Modes: development | test | production
#
# VITE_API_BASE_URL
#   Empty → browser calls same origin; Vite proxies /api (dev/test).
#   Set → browser calls that origin directly (must have a trusted cert).
#
# VITE_API_PROXY_TARGET
#   Upstream API for the Vite proxy (e.g. https://localhost:7029).
#
# VITE_PROXY_INSECURE_TLS
#   true  → Node proxy ignores self-signed / untrusted HTTPS certs (dev/test only).
#   false → verify TLS (production). Browsers never bypass certs; this only
#           affects the Vite proxy process.

VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=https://localhost:7029
VITE_PROXY_INSECURE_TLS=true
