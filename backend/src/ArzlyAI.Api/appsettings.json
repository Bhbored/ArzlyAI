{
  "ConnectionStrings": {
    "Catalog": "Host=localhost;Port=5432;Database=arzlyai;Username=postgres;Password=123456"
  },
  "AllowedOrigins": [],
  "Nango": {
    "ApiKey": "",
    "BaseUrl": "https://api.nango.dev",
    "LinkedInIntegrationId": "linkedin"
  },
  "RateLimits": {
    "PresetReads": {
      "PermitLimit": 600,
      "WindowSeconds": 60
    },
    "Security": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    },
    "WorkflowExecution": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    },
    "SignalR": {
      "PermitLimit": 600,
      "WindowSeconds": 60
    },
    "Connectors": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://localhost:5341" }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": { "ApplicationName": "ArzlyAI Backend" }
  }
}
